# このファイルをコピーして .env を作る: cp .env.example .env
# .env は Git に含めないこと(.gitignore で除外済み)

# あなたの大学の Moodle の URL(末尾の / は不要)
MOODLE_URL=https://moodle.example.ac.jp

# Moodle Web Services のトークン。`uv run moodle login` で自動的に書き込まれる
MOODLE_TOKEN=

# トークン取得に使うサービス名(通常は変更不要)
MOODLE_SERVICE=moodle_mobile_app

# 表示用のタイムゾーン(クラウドで動く AI などでも日本時間で出すため。日本以外なら変える)
MOODLE_TIMEZONE=Asia/Tokyo

# --- Discord 通知 ---
# 友達との共有チャンネルの Webhook(新着課題・締切変更・小テスト公開)
DISCORD_WEBHOOK_URL=
# 自分専用チャンネルの Webhook(未提出課題のリマインド)。任意
PERSONAL_WEBHOOK_URL=
